{
  "schemaVersion": 1,
  "id": "healthindicators",
  "version": "${version}",

  "name": "Health Indicators",
  "description": "Simple damage indicator mod that shows a floating health bar (or number) above Players and Mobs. [Nikey Fork]",
  "authors": ["AdyTech99", "Nikey"],
  "contributors": [
    "Translation key (ru_ru): Alexander317"
  ],

  "contact": {
    "homepage": "https://modrinth.com/mod/health-indicators-fairplay",
    "sources": "https://github.com/NikeyV1/HealthIndicators",
    "issues": "https://github.com/NikeyV1/HealthIndicators/issues"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/invite/4eWX2duHfJ"
      },
      "update_checker": true
    }
  },

  "license": "LGPL v3",
  "icon": "assets/healthindicators/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.adytech99.healthindicators.fabric.HealthIndicatorsFabric"
    ],
    "modmenu" : ["io.github.adytech99.healthindicators.fabric.config.ModMenuAPIImpl"]
  },
  "accessWidener": "healthindicators.accesswidener",
  "mixins": [
    "healthindicators.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric": "*",
    "minecraft": ">=26.2",
    "architectury": ">=21.0.2",
    "yet_another_config_lib_v3": "*",
    "java": ">=25"
  }
}